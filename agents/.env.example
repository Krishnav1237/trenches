# Environment variables for Trenches AI Agent System
# Copy this to .env and fill in your API keys

# Anthropic API Key (required for Anthropic/Claude agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key (required for Groq/Llama agents)
GROQ_API_KEY=your_groq_api_key_here

# X (Twitter) API Configuration (for publishing agent tweets to Twitter)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Backend Configuration
BACKEND_URL=http://localhost:8080